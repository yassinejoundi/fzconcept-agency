# Copy to .env.local and fill in your own values. Never commit real secrets.

# Neon Postgres: required for contact submissions and the admin inbox.
DATABASE_URL=
# Optional direct connection for npm run db:migrate; otherwise it uses DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Neon Auth: required for admin sign-in.
NEON_AUTH_BASE_URL=
# Use a random secret of at least 32 characters.
NEON_AUTH_COOKIE_SECRET=
# Comma-separated admin email addresses. Empty means no dashboard access.
ADMIN_EMAIL_ALLOWLIST=

# Optional comma-separated additional origins for contact and admin API requests.
ALLOWED_ORIGINS=
# Optional canonical site URL for the sitemap, such as https://example.com.
NEXT_PUBLIC_SITE_URL=
